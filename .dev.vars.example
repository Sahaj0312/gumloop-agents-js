# Server secrets for local Wrangler development. Copy to .dev.vars.
# Use a long, random password for the studio owner.
STUDIO_PASSWORD="replace_with_a_long_random_password"
# Generate 32 random bytes as 64 hex characters; keep this stable after connecting.
ENCRYPTION_KEY="replace_with_64_random_hex_characters"
# Optional: preconnect your account. Otherwise connect in the authenticated studio.
GUMLOOP_API_KEY=""
GUMLOOP_USER_ID=""
