# Server-side only. Never put these values in frontend code.
GUMLOOP_API_KEY=your_api_key
GUMLOOP_USER_ID=your_user_id
# Alternatively supply an OAuth access token instead of a personal API key.
# GUMLOOP_ACCESS_TOKEN=your_access_token
# GUMLOOP_TEAM_ID=your_team_id
# PORT=3000

# Embeddable widget: use a dedicated agent intended for public visitors.
GUMLOOP_WIDGET_AGENT_ID=your_public_agent_id
GUMLOOP_WIDGET_ALLOWED_ORIGINS=http://127.0.0.1:3100
GUMLOOP_WIDGET_TITLE=Ask our team
GUMLOOP_WIDGET_WELCOME=Hi! How can I help?
GUMLOOP_WIDGET_ACCENT="#bc6547"
# WIDGET_PORT=3001
# For a hosted backend behind HTTPS:
# GUMLOOP_WIDGET_PUBLIC_URL=https://chat.example.com
# GUMLOOP_WIDGET_HOST=0.0.0.0
