{
  "name": "gumloop-agents-js",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial TypeScript client and chat demo for Gumloop's Agents API",
  "type": "module",
  "engines": { "node": ">=20.12" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node examples/chat/server.mjs"
  },
  "devDependencies": { "@types/node": "^22.10.2", "typescript": "^5.7.2" }
}
